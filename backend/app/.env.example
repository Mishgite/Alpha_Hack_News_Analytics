# Общие настройки проекта: скопируйте этот файл в .env в backend/app.
# Если .env уже существует, добавьте недостающие параметры, не перезаписывая секреты.
# Настоящие пароли и API-ключи храните только в .env или переменных окружения.
# Переменные окружения имеют приоритет над .env. Не добавляйте комментарии после значений.

# PostgreSQL: замените пароль; специальные символы пароля кодируйте для URL (@ -> %40).
DATABASE_URL=postgresql+psycopg://postgres:replace_with_local_password@127.0.0.1:5432/alfa_news
# Размер постоянного пула соединений и дополнительный лимит, целые числа >= 1.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# AI: ключ команды из инструкции организаторов. Не передавайте его во frontend.
LLM_API_KEY=replace_with_team_api_key
LLM_BASE_URL=https://changellenge.up.railway.app/v1
# Резервный адрес: https://api.alfahack-gateway26.ru/v1
# Разметка новостей (Qwen3.6 35B A3B).
LLM_MODEL_TAGGING=qwen/qwen3.6-35b-a3b
# Интересы компании/сотрудника (GLM-5.3-Flash).
LLM_MODEL_CONTEXT=z-ai/glm-5.3-flash

# Локальная разработка; не используйте эти значения в production.
POSTGRES_DB=alfa_news
POSTGRES_USER=postgres
POSTGRES_PASSWORD=alfa_local_dev

# Используется 5433, чтобы не конфликтовать с локальным PostgreSQL на 5432.
POSTGRES_PORT=5433

API_PORT=8000
FRONTEND_PORT=5173
API_DEMO_ENABLED=true

# Нужен только для профиля worker и реальных AI-вызовов; не запускать без согласованного бюджета.
LLM_API_KEY=
LLM_BASE_URL=https://changellenge.up.railway.app/v1
LLM_MODEL_TAGGING=qwen/qwen3.6-35b-a3b
LLM_MODEL_CONTEXT=z-ai/glm-5.3-flash
LLM_MODEL_ANALYSIS=z-ai/glm-5.3-flash
LLM_DAILY_REQUEST_LIMIT=100
LLM_BUDGET_RESERVE_RUB=50
LLM_MAX_OUTPUT_TOKENS=8192
